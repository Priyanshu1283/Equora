# Database
MONGODB_URI=mongodb://localhost:27017/equora

# Auth.js / NextAuth
AUTH_SECRET=generate_a_random_32_char_secret_with_openssl
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional in Dev Mode, required for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Dev Fallback Authentication (Set to true to allow 1-click test user login)
ALLOW_DEV_LOGIN=true

# Optional: Resend for Email Invites
RESEND_API_KEY=
EMAIL_FROM=Equora <noreply@example.com>
